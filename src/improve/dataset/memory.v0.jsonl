{"id":"mem-004","description":"ack_notification marks that notification as read=true","tags":["memory","notifications"],"type":"applyTick","input":{"memory":{"postedByMe":[],"commentedByMe":[],"notifications":[{"id":"n_001","type":"reply","postId":"p_abc","read":false}]},"toolCallRecords":[{"toolName":"ack_notification","args":{"notificationId":"n_001"},"result":{"content":[{"text":"ok"}]},"isError":false}]},"expected":{"assertions":[{"type":"notificationRead","notificationId":"n_001","value":true}]}}
{"id":"mem-005","description":"get_my_notifications merges new notifications by id (upsert, no duplicates)","tags":["memory","notifications","dedup"],"type":"applyTick","input":{"memory":{"postedByMe":[],"commentedByMe":[],"notifications":[{"id":"n_001","type":"reply","read":false}]},"toolCallRecords":[{"toolName":"get_my_notifications","args":{},"result":{"content":[{"text":"[{\"id\":\"n_001\",\"type\":\"reply\",\"read\":false},{\"id\":\"n_002\",\"type\":\"upvote\",\"read\":false}]"}]},"isError":false}]},"expected":{"assertions":[{"type":"notificationsLength","value":2},{"type":"notificationsUnique"}]}}
{"id":"mem-006","description":"get_my_notifications called twice does not duplicate entries","tags":["memory","notifications","dedup"],"type":"applyTick","input":{"memory":{"postedByMe":[],"commentedByMe":[],"notifications":[]},"toolCallRecords":[{"toolName":"get_my_notifications","args":{},"result":{"content":[{"text":"[{\"id\":\"n_001\",\"type\":\"reply\",\"read\":false},{\"id\":\"n_001\",\"type\":\"reply\",\"read\":false}]"}]},"isError":false}]},"expected":{"assertions":[{"type":"notificationsLength","value":1},{"type":"notificationsUnique"}]}}
