{"id":"mem-001","description":"createPost tool adds entry to postedByMe","tags":["memory","post"],"type":"applyTick","input":{"memory":{"postedByMe":[],"commentedByMe":[],"notifications":[]},"toolCallRecords":[{"toolName":"create_post","args":{"title":"My First Post","subcom":"tech"},"result":{"content":[{"text":"{\"postId\":\"p_001\",\"title\":\"My First Post\"}"}]},"isError":false}]},"expected":{"assertions":[{"type":"postedByMeLength","value":1},{"type":"postedByMeContains","postId":"p_001"},{"type":"postCooldownSet","value":true}]}}
{"id":"mem-002","description":"isError:true tool calls are ignored — memory unchanged","tags":["memory","error-handling"],"type":"applyTick","input":{"memory":{"postedByMe":[],"commentedByMe":[],"notifications":[]},"toolCallRecords":[{"toolName":"create_post","args":{"title":"Failed Post"},"result":{"content":[{"text":"Internal Server Error"}]},"isError":true}]},"expected":{"assertions":[{"type":"postedByMeLength","value":0},{"type":"postCooldownSet","value":false}]}}
