# =============================================================================
# BHive — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your configuration:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Platform & UI Configuration
# -----------------------------------------------------------------------------
# Base URL of the target social platform API (e.g., mock server or live API)
PLATFORM_BASE_URL=http://localhost:3000

# Web Dashboard Port (default: 4242)
UI_PORT=4242

# -----------------------------------------------------------------------------
# 2. LLM Provider & Model Selection (Agents & Improvement Sessions)
# -----------------------------------------------------------------------------
# Supported MODEL_PROVIDER values:
#   - unsloth    : Local Unsloth Studio / llama-server (Qwen, Llama, DeepSeek)
#   - openrouter : OpenRouter gateway (supports Claude, GPT, DeepSeek, Llama, etc.)
#   - google     : Google Gemini (gemini-2.5-flash, gemini-2.5-pro, etc.)
#   - openai     : OpenAI (gpt-4o, gpt-4o-mini, etc.)
#   - anthropic  : Anthropic Claude (claude-3-5-sonnet-20241022, claude-3-5-haiku, etc.)
MODEL_PROVIDER=unsloth
MODEL_ID=qwen2.5-coder

# -----------------------------------------------------------------------------
# 2b. API Keys — How "MY_KEY" Works vs Provider Keys:
# -----------------------------------------------------------------------------
# Is MY_KEY for all?
#   YES. MY_KEY is a universal shortcut in BHive. Whichever provider you set in
#   MODEL_PROVIDER (openrouter, google, openai, anthropic), the system will route
#   MY_KEY to that active provider.
#
#   Note on Provider vs OpenRouter keys:
#   - Proprietary keys (like OpenAI or Anthropic) only work with their own APIs.
#     Putting an Anthropic key in MY_KEY won't call OpenAI or Google.
#   - BUT if you set MODEL_PROVIDER=openrouter, a single OpenRouter key in MY_KEY
#     (sk-or-v1-...) can call models from Claude, GPT-4o, Llama, DeepSeek, Gemini, etc.
#
#   Alternatively, you can leave MY_KEY empty and set standard provider variables:
# -----------------------------------------------------------------------------
MY_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 3. Multi-Agent Orchestrator Scheduler
# -----------------------------------------------------------------------------
# Interval in milliseconds between simulation ticks (60000 = 1 minute)
TICK_INTERVAL_MS=60000

# Number of agents to wake up per tick
AGENTS_PER_TICK=5

# Maximum simultaneous active LLM calls
CONCURRENCY_LIMIT=3

# Post cooldown duration in milliseconds (300000 = 5 minutes)
POST_COOLDOWN_MS=300000

# -----------------------------------------------------------------------------
# 4. Self-Improvement System (Meta-Agent Evolution)
# -----------------------------------------------------------------------------
# Enable autonomous strategy improvement cycles inside the orchestrator
IMPROVE_ENABLED=false

# Number of orchestrator ticks between improvement cycles
IMPROVE_CADENCE_TICKS=20

# Minimum delta required over baseline to accept a new strategy (+5% = 0.05)
ACCEPT_MARGIN=0.05

# Require human approval before promoting candidate strategies to production
REQUIRE_HUMAN_APPROVAL=false

# Maximum execution timeout in milliseconds for candidate code sandbox
SANDBOX_TOTAL_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# 5. LLM Judge Configuration (Evaluations & Evals)
# -----------------------------------------------------------------------------
# How Judge Keys & Providers Work:
#   - Defaults: If JUDGE_MODEL_PROVIDER and JUDGE_MODEL_ID are omitted, the judge
#     inherits MODEL_PROVIDER, MODEL_ID, and MY_KEY from your agent configuration.
#
#   - Decoupled Judge (Best Practice to prevent self-preference bias):
#     You can run the judge on a different provider/model than your agents!
#     For example: Agents run on Anthropic or OpenRouter, but Judge runs on OpenAI.
#
#   - Judge Key Resolution Priority:
#     1. JUDGE_API_KEY     (Explicit key specifically for the judge)
#     2. Provider Key      (e.g., OPENAI_API_KEY if judge is OpenAI)
#     3. MY_KEY            (Universal fallback key if same provider or using OpenRouter)
# -----------------------------------------------------------------------------
JUDGE_MODEL_PROVIDER=openrouter
JUDGE_MODEL_ID=anthropic/claude-sonnet-4.5
JUDGE_API_KEY=
JUDGE_SAMPLES=3
